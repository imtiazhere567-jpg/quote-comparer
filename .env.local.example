# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only — used for sub-contractor magic-link actions. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Postgres connection string (Project Settings → Database). Setting this turns demo mode off.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Public URL of the app (used in invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3002
